rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function isAdmin() {
      return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)) && me().data.role == 'admin';
    }
    // Lần khởi tạo đầu tiên: tạo tài khoản quản trị khi chưa có meta/admin.
    function bootstrapping() {
      return signedIn()
        && !exists(/databases/$(db)/documents/meta/admin)
        && getAfter(/databases/$(db)/documents/meta/admin).data.uid == request.auth.uid;
    }

    match /meta/admin {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }
    match /meta/settings {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Ánh xạ tên đăng nhập → email nội bộ (cần đọc được trước khi đăng nhập).
    match /logins/{username} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin() || bootstrapping();
    }
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (bootstrapping() && request.auth.uid == uid);
      allow update, delete: if isAdmin();
    }
    match /credentials/{uid} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (bootstrapping() && request.auth.uid == uid);
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password']));
      allow delete: if isAdmin();
    }
    match /questions/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /exams/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /attempts/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.state == 'inprogress';
      // Học sinh chỉ được sửa lượt thi của mình khi đang làm bài, và không được đổi đề/thời gian.
      allow update: if isAdmin() || (signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.state == 'inprogress'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'items', 'startedAt', 'deadline', 'exam', 'examId']));
      allow delete: if isAdmin();
    }
  }
}
